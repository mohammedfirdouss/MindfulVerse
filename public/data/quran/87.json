[{"surah":87,"ayah":1,"verseKey":"87:1","arabic":"سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى","translation":"Praise the Name of your Lord, the Most High"},{"surah":87,"ayah":2,"verseKey":"87:2","arabic":"ٱلَّذِي خَلَقَ فَسَوَّىٰ","translation":"He who creates and regulates"},{"surah":87,"ayah":3,"verseKey":"87:3","arabic":"وَٱلَّذِي قَدَّرَ فَهَدَىٰ","translation":"He who measures and guides"},{"surah":87,"ayah":4,"verseKey":"87:4","arabic":"وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ","translation":"He who produces the pasture"},{"surah":87,"ayah":5,"verseKey":"87:5","arabic":"فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ","translation":"And then turns it into light debris"},{"surah":87,"ayah":6,"verseKey":"87:6","arabic":"سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ","translation":"We will make you read, so do not forget"},{"surah":87,"ayah":7,"verseKey":"87:7","arabic":"إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ","translation":"Except what God wills. He knows what is declared, and what is hidden"},{"surah":87,"ayah":8,"verseKey":"87:8","arabic":"وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ","translation":"We will ease you into the Easy Way"},{"surah":87,"ayah":9,"verseKey":"87:9","arabic":"فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ","translation":"So remind, if reminding helps"},{"surah":87,"ayah":10,"verseKey":"87:10","arabic":"سَيَذَّكَّرُ مَن يَخۡشَىٰ","translation":"The reverent will remember"},{"surah":87,"ayah":11,"verseKey":"87:11","arabic":"وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى","translation":"But the wretched will avoid it"},{"surah":87,"ayah":12,"verseKey":"87:12","arabic":"ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ","translation":"He who will enter the Gigantic Fire"},{"surah":87,"ayah":13,"verseKey":"87:13","arabic":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ","translation":"Where he will neither die, nor live"},{"surah":87,"ayah":14,"verseKey":"87:14","arabic":"قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ","translation":"Successful is he who purifies himself"},{"surah":87,"ayah":15,"verseKey":"87:15","arabic":"وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ","translation":"And mentions the name of his Lord, and prays"},{"surah":87,"ayah":16,"verseKey":"87:16","arabic":"بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا","translation":"But you prefer the present life"},{"surah":87,"ayah":17,"verseKey":"87:17","arabic":"وَٱلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقَىٰٓ","translation":"Though the Hereafter is better, and more lasting"},{"surah":87,"ayah":18,"verseKey":"87:18","arabic":"إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ","translation":"This is in the former scriptures"},{"surah":87,"ayah":19,"verseKey":"87:19","arabic":"صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ","translation":"The Scriptures of Abraham and Moses"}]