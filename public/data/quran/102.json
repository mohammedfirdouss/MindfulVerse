[{"surah":102,"ayah":1,"verseKey":"102:1","arabic":"أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ","translation":"Abundance distracts you"},{"surah":102,"ayah":2,"verseKey":"102:2","arabic":"حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ","translation":"Until you visit the graveyards"},{"surah":102,"ayah":3,"verseKey":"102:3","arabic":"كـَلَّا سَوۡفَ تَعۡلَمُونَ","translation":"Indeed, you will know"},{"surah":102,"ayah":4,"verseKey":"102:4","arabic":"ثُمَّ كـَلَّا سَوۡفَ تَعۡلَمُونَ","translation":"Certainly, you will know"},{"surah":102,"ayah":5,"verseKey":"102:5","arabic":"كـَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ","translation":"If you knew with knowledge of certainty"},{"surah":102,"ayah":6,"verseKey":"102:6","arabic":"لَتَرَوُنَّ ٱلۡجَحِيمَ","translation":"You would see the Inferno"},{"surah":102,"ayah":7,"verseKey":"102:7","arabic":"ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ","translation":"Then you will see it with the eye of certainty"},{"surah":102,"ayah":8,"verseKey":"102:8","arabic":"ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ","translation":"Then, on that Day, you will be questioned about the Bliss"}]