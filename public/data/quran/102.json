[{"surah":102,"ayah":1,"verseKey":"102:1","arabic":"أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ","translation":"The mutual rivalry for piling up (the good things of this world) diverts you (from the more serious things)"},{"surah":102,"ayah":2,"verseKey":"102:2","arabic":"حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ","translation":"Until ye visit the graves"},{"surah":102,"ayah":3,"verseKey":"102:3","arabic":"كـَلَّا سَوۡفَ تَعۡلَمُونَ","translation":"But nay, ye soon shall know (the reality)"},{"surah":102,"ayah":4,"verseKey":"102:4","arabic":"ثُمَّ كـَلَّا سَوۡفَ تَعۡلَمُونَ","translation":"Again, ye soon shall know"},{"surah":102,"ayah":5,"verseKey":"102:5","arabic":"كـَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ","translation":"Nay, were ye to know with certainty of mind, (ye would beware)"},{"surah":102,"ayah":6,"verseKey":"102:6","arabic":"لَتَرَوُنَّ ٱلۡجَحِيمَ","translation":"Ye shall certainly see Hell-Fire"},{"surah":102,"ayah":7,"verseKey":"102:7","arabic":"ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ","translation":"Again, ye shall see it with certainty of sight"},{"surah":102,"ayah":8,"verseKey":"102:8","arabic":"ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ","translation":"Then, shall ye be questioned that Day about the joy (ye indulged in)"}]