[{"surah":107,"ayah":1,"verseKey":"107:1","arabic":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ","translation":"Seest thou one who denies the Judgment (to come)"},{"surah":107,"ayah":2,"verseKey":"107:2","arabic":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ","translation":"Then such is the (man) who repulses the orphan (with harshness)"},{"surah":107,"ayah":3,"verseKey":"107:3","arabic":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","translation":"And encourages not the feeding of the indigent"},{"surah":107,"ayah":4,"verseKey":"107:4","arabic":"فَوَيۡلٞ لِّلۡمُصَلِّينَ","translation":"So woe to the worshippers"},{"surah":107,"ayah":5,"verseKey":"107:5","arabic":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ","translation":"Who are neglectful of their prayers"},{"surah":107,"ayah":6,"verseKey":"107:6","arabic":"ٱلَّذِينَ هُمۡ يُرَآءُونَ","translation":"Those who (want but) to be seen (of men)"},{"surah":107,"ayah":7,"verseKey":"107:7","arabic":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ","translation":"But refuse (to supply) (even) neighbourly needs"}]