[{"surah":100,"ayah":1,"verseKey":"100:1","arabic":"وَٱلۡعَٰدِيَٰتِ ضَبۡحٗا","translation":"By the racers panting"},{"surah":100,"ayah":2,"verseKey":"100:2","arabic":"فَٱلۡمُورِيَٰتِ قَدۡحٗا","translation":"Igniting sparks"},{"surah":100,"ayah":3,"verseKey":"100:3","arabic":"فَٱلۡمُغِيرَٰتِ صُبۡحٗا","translation":"Raiding at dawn"},{"surah":100,"ayah":4,"verseKey":"100:4","arabic":"فَأَثَرۡنَ بِهِۦ نَقۡعٗا","translation":"Raising clouds of dust"},{"surah":100,"ayah":5,"verseKey":"100:5","arabic":"فَوَسَطۡنَ بِهِۦ جَمۡعًا","translation":"Storming into the midst"},{"surah":100,"ayah":6,"verseKey":"100:6","arabic":"إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٞ","translation":"Indeed, the human being is ungrateful to his Lord"},{"surah":100,"ayah":7,"verseKey":"100:7","arabic":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ","translation":"And he bears witness to that"},{"surah":100,"ayah":8,"verseKey":"100:8","arabic":"وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ","translation":"And he is fierce in his love of wealth"},{"surah":100,"ayah":9,"verseKey":"100:9","arabic":"۞ أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ","translation":"Does he not know? When the contents of the graves are scattered around"},{"surah":100,"ayah":10,"verseKey":"100:10","arabic":"وَحُصِّلَ مَا فِي ٱلصُّدُورِ","translation":"And the contents of the hearts are obtained"},{"surah":100,"ayah":11,"verseKey":"100:11","arabic":"إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذٖ لَّخَبِيرُۢ","translation":"Their Lord, on that Day, is fully informed of them"}]