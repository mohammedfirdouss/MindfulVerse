[{"surah":101,"ayah":1,"verseKey":"101:1","arabic":"ٱلۡقَارِعَةُ","translation":"The (Day) of Noise and Clamour"},{"surah":101,"ayah":2,"verseKey":"101:2","arabic":"مَا ٱلۡقَارِعَةُ","translation":"What is the (Day) of Noise and Clamour"},{"surah":101,"ayah":3,"verseKey":"101:3","arabic":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ","translation":"And what will explain to thee what the (Day) of Noise and Clamour is"},{"surah":101,"ayah":4,"verseKey":"101:4","arabic":"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ","translation":"(It is) a Day whereon men will be like moths scattered about"},{"surah":101,"ayah":5,"verseKey":"101:5","arabic":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ","translation":"And the mountains will be like carded wool"},{"surah":101,"ayah":6,"verseKey":"101:6","arabic":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ","translation":"Then, he whose balance (of good deeds) will be (found) heavy"},{"surah":101,"ayah":7,"verseKey":"101:7","arabic":"فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ","translation":"Will be in a life of good pleasure and satisfaction"},{"surah":101,"ayah":8,"verseKey":"101:8","arabic":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ","translation":"But he whose balance (of good deeds) will be (found) light"},{"surah":101,"ayah":9,"verseKey":"101:9","arabic":"فَأُمُّهُۥ هَاوِيَةٞ","translation":"Will have his home in a (bottomless) Pit"},{"surah":101,"ayah":10,"verseKey":"101:10","arabic":"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ","translation":"And what will explain to thee what this is"},{"surah":101,"ayah":11,"verseKey":"101:11","arabic":"نَارٌ حَامِيَةُۢ","translation":"(It is) a Fire Blazing fiercely"}]