[{"surah":94,"ayah":1,"verseKey":"94:1","arabic":"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ","translation":"Did We not soothe your heart"},{"surah":94,"ayah":2,"verseKey":"94:2","arabic":"وَوَضَعۡنَا عَنكَ وِزۡرَكَ","translation":"And lift from you your burden"},{"surah":94,"ayah":3,"verseKey":"94:3","arabic":"ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ","translation":"Which weighed down your back"},{"surah":94,"ayah":4,"verseKey":"94:4","arabic":"وَرَفَعۡنَا لَكَ ذِكۡرَكَ","translation":"And raised for you your reputation"},{"surah":94,"ayah":5,"verseKey":"94:5","arabic":"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا","translation":"With hardship comes ease"},{"surah":94,"ayah":6,"verseKey":"94:6","arabic":"إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرٗا","translation":"With hardship comes ease"},{"surah":94,"ayah":7,"verseKey":"94:7","arabic":"فَإِذَا فَرَغۡتَ فَٱنصَبۡ","translation":"When your work is done, turn to devotion"},{"surah":94,"ayah":8,"verseKey":"94:8","arabic":"وَإِلَىٰ رَبِّكَ فَٱرۡغَب","translation":"And to your Lord turn for everything"}]