[{"surah":96,"ayah":1,"verseKey":"96:1","arabic":"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ","translation":"Read: In the Name of your Lord who created"},{"surah":96,"ayah":2,"verseKey":"96:2","arabic":"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ","translation":"Created man from a clot"},{"surah":96,"ayah":3,"verseKey":"96:3","arabic":"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ","translation":"Read: And your Lord is the Most Generous"},{"surah":96,"ayah":4,"verseKey":"96:4","arabic":"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ","translation":"He who taught by the pen"},{"surah":96,"ayah":5,"verseKey":"96:5","arabic":"عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ","translation":"Taught man what he never knew"},{"surah":96,"ayah":6,"verseKey":"96:6","arabic":"كـَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ","translation":"In fact, man oversteps all bounds"},{"surah":96,"ayah":7,"verseKey":"96:7","arabic":"أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ","translation":"When he considers himself exempt"},{"surah":96,"ayah":8,"verseKey":"96:8","arabic":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ","translation":"But to your Lord is the return"},{"surah":96,"ayah":9,"verseKey":"96:9","arabic":"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ","translation":"Have you seen him who prevents"},{"surah":96,"ayah":10,"verseKey":"96:10","arabic":"عَبۡدًا إِذَا صَلَّىٰٓ","translation":"A servant when he prays"},{"surah":96,"ayah":11,"verseKey":"96:11","arabic":"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ","translation":"Do you think he is upon guidance"},{"surah":96,"ayah":12,"verseKey":"96:12","arabic":"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ","translation":"Or advocates righteousness"},{"surah":96,"ayah":13,"verseKey":"96:13","arabic":"أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","translation":"Do you see how he disbelieved and turned away"},{"surah":96,"ayah":14,"verseKey":"96:14","arabic":"أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ","translation":"Does he not know that God sees"},{"surah":96,"ayah":15,"verseKey":"96:15","arabic":"كـَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ","translation":"No. If he does not desist, We will drag him by the forelock"},{"surah":96,"ayah":16,"verseKey":"96:16","arabic":"نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖ","translation":"A deceitful, sinful forelock"},{"surah":96,"ayah":17,"verseKey":"96:17","arabic":"فَلۡيَدۡعُ نَادِيَهُۥ","translation":"Let him call on his gang"},{"surah":96,"ayah":18,"verseKey":"96:18","arabic":"سَنَدۡعُ ٱلزَّبَانِيَةَ","translation":"We will call the Guards"},{"surah":96,"ayah":19,"verseKey":"96:19","arabic":"كـَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩","translation":"No, do not obey him; but kneel down, and come near"}]