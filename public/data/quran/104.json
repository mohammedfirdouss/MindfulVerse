[{"surah":104,"ayah":1,"verseKey":"104:1","arabic":"وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ","translation":"Woe to every slanderer backbiter"},{"surah":104,"ayah":2,"verseKey":"104:2","arabic":"ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ","translation":"Who gathers wealth and counts it over"},{"surah":104,"ayah":3,"verseKey":"104:3","arabic":"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ","translation":"Thinking that his wealth has made him immortal"},{"surah":104,"ayah":4,"verseKey":"104:4","arabic":"كـَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ","translation":"By no means. He will be thrown into the Crusher"},{"surah":104,"ayah":5,"verseKey":"104:5","arabic":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ","translation":"And what will make you realize what the Crusher is"},{"surah":104,"ayah":6,"verseKey":"104:6","arabic":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ","translation":"God's kindled Fire"},{"surah":104,"ayah":7,"verseKey":"104:7","arabic":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ","translation":"That laps to the hearts"},{"surah":104,"ayah":8,"verseKey":"104:8","arabic":"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ","translation":"It closes in on them"},{"surah":104,"ayah":9,"verseKey":"104:9","arabic":"فِي عَمَدٖ مُّمَدَّدَةِۭ","translation":"In extended columns"}]