[{"surah":109,"ayah":1,"verseKey":"109:1","arabic":"قُلۡ يَٰٓأَيُّهَا ٱلۡكَٰفِرُونَ","translation":"Say, “O disbelievers"},{"surah":109,"ayah":2,"verseKey":"109:2","arabic":"لَآ أَعۡبُدُ مَا تَعۡبُدُونَ","translation":"I do not worship what you worship"},{"surah":109,"ayah":3,"verseKey":"109:3","arabic":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","translation":"Nor do you worship what I worship"},{"surah":109,"ayah":4,"verseKey":"109:4","arabic":"وَلَآ أَنَا۠ عَابِدٞ مَّا عَبَدتُّمۡ","translation":"Nor do I serve what you serve"},{"surah":109,"ayah":5,"verseKey":"109:5","arabic":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","translation":"Nor do you serve what I serve"},{"surah":109,"ayah":6,"verseKey":"109:6","arabic":"لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ","translation":"You have your way, and I have my way.”"}]