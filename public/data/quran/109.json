[{"surah":109,"ayah":1,"verseKey":"109:1","arabic":"قُلۡ يَٰٓأَيُّهَا ٱلۡكَٰفِرُونَ","translation":"Say: O ye that reject Faith"},{"surah":109,"ayah":2,"verseKey":"109:2","arabic":"لَآ أَعۡبُدُ مَا تَعۡبُدُونَ","translation":"I worship not that which ye worship"},{"surah":109,"ayah":3,"verseKey":"109:3","arabic":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","translation":"Nor will ye worship that which I worship"},{"surah":109,"ayah":4,"verseKey":"109:4","arabic":"وَلَآ أَنَا۠ عَابِدٞ مَّا عَبَدتُّمۡ","translation":"And I will not worship that which ye have been wont to worship"},{"surah":109,"ayah":5,"verseKey":"109:5","arabic":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","translation":"Nor will ye worship that which I worship"},{"surah":109,"ayah":6,"verseKey":"109:6","arabic":"لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ","translation":"To you be your Way, and to me mine"}]