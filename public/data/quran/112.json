[{"surah":112,"ayah":1,"verseKey":"112:1","arabic":"قُلۡ هُوَ ٱللَّهُ أَحَدٌ","translation":"Say: He is Allah, the One and Only"},{"surah":112,"ayah":2,"verseKey":"112:2","arabic":"ٱللَّهُ ٱلصَّمَدُ","translation":"Allah, the Eternal, Absolute"},{"surah":112,"ayah":3,"verseKey":"112:3","arabic":"لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ","translation":"He begetteth not, nor is He begotten"},{"surah":112,"ayah":4,"verseKey":"112:4","arabic":"وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ","translation":"And there is none like unto Him"}]