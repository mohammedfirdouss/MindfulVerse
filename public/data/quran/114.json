[{"surah":114,"ayah":1,"verseKey":"114:1","arabic":"قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ","translation":"Say, “I seek refuge in the Lord of mankind"},{"surah":114,"ayah":2,"verseKey":"114:2","arabic":"مَلِكِ ٱلنَّاسِ","translation":"The King of mankind"},{"surah":114,"ayah":3,"verseKey":"114:3","arabic":"إِلَٰهِ ٱلنَّاسِ","translation":"The God of mankind"},{"surah":114,"ayah":4,"verseKey":"114:4","arabic":"مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ","translation":"From the evil of the sneaky whisperer"},{"surah":114,"ayah":5,"verseKey":"114:5","arabic":"ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ","translation":"Who whispers into the hearts of people"},{"surah":114,"ayah":6,"verseKey":"114:6","arabic":"مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ","translation":"From among jinn and among people.”"}]