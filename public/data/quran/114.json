[{"surah":114,"ayah":1,"verseKey":"114:1","arabic":"قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ","translation":"Say: I seek refuge with the Lord and Cherisher of Mankind"},{"surah":114,"ayah":2,"verseKey":"114:2","arabic":"مَلِكِ ٱلنَّاسِ","translation":"The King (or Ruler) of Mankind"},{"surah":114,"ayah":3,"verseKey":"114:3","arabic":"إِلَٰهِ ٱلنَّاسِ","translation":"The god (or judge) of Mankind"},{"surah":114,"ayah":4,"verseKey":"114:4","arabic":"مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ","translation":"From the mischief of the Whisperer (of Evil), who withdraws (after his whisper)"},{"surah":114,"ayah":5,"verseKey":"114:5","arabic":"ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ","translation":"(The same) who whispers into the hearts of Mankind"},{"surah":114,"ayah":6,"verseKey":"114:6","arabic":"مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ","translation":"Among Jinns and among men"}]