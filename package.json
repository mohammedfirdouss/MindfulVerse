{
  "name": "mindfulverse",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev -w @mindfulverse/web",
    "build": "npm run typecheck -w @mindfulverse/core && npm run build -w @mindfulverse/web",
    "preview": "npm run preview -w @mindfulverse/web",
    "typecheck": "npm run typecheck -w @mindfulverse/core",
    "build:data": "node scripts/build-data.mjs",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e -w @mindfulverse/web",
    "build:brand": "node scripts/build-brand.mjs",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "build:functions": "node scripts/build-functions.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.49",
    "better-sqlite3": "^11.3.0",
    "esbuild": "0.21.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.90.0",
    "playwright": "1.49",
    "typescript": "^5.5.4",
    "ultracite": "^8.1.0",
    "vitest": "^2.1.9"
  }
}
