[{"surah":108,"ayah":1,"verseKey":"108:1","arabic":"إِنَّآ أَعۡطَيۡنَٰكَ ٱلۡكَوۡثَرَ","translation":"We have given you plenty"},{"surah":108,"ayah":2,"verseKey":"108:2","arabic":"فَصَلِّ لِرَبِّكَ وَٱنۡحَرۡ","translation":"So pray to your Lord and sacrifice"},{"surah":108,"ayah":3,"verseKey":"108:3","arabic":"إِنَّ شَانِئَكَ هُوَ ٱلۡأَبۡتَرُ","translation":"He who hates you is the loser"}]