[{"surah":86,"ayah":1,"verseKey":"86:1","arabic":"وَٱلسَّمَآءِ وَٱلطَّارِقِ","translation":"By the sky and at-Tariq"},{"surah":86,"ayah":2,"verseKey":"86:2","arabic":"وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ","translation":"But what will let you know what at-Tariq is"},{"surah":86,"ayah":3,"verseKey":"86:3","arabic":"ٱلنَّجۡمُ ٱلثَّاقِبُ","translation":"The Piercing Star"},{"surah":86,"ayah":4,"verseKey":"86:4","arabic":"إِن كُلُّ نَفۡسٖ لَّمَّا عَلَيۡهَا حَافِظٞ","translation":"There is no soul without a Protector over it"},{"surah":86,"ayah":5,"verseKey":"86:5","arabic":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ","translation":"Let man consider what he was created from"},{"surah":86,"ayah":6,"verseKey":"86:6","arabic":"خُلِقَ مِن مَّآءٖ دَافِقٖ","translation":"He was created from gushing liquid"},{"surah":86,"ayah":7,"verseKey":"86:7","arabic":"يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ","translation":"Issuing from between the backbone and the breastbones"},{"surah":86,"ayah":8,"verseKey":"86:8","arabic":"إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرٞ","translation":"He is certainly able to return him"},{"surah":86,"ayah":9,"verseKey":"86:9","arabic":"يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ","translation":"On the Day when the secrets are disclosed"},{"surah":86,"ayah":10,"verseKey":"86:10","arabic":"فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖ","translation":"He will have no strength, and no supporter"},{"surah":86,"ayah":11,"verseKey":"86:11","arabic":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ","translation":"By the sky that returns"},{"surah":86,"ayah":12,"verseKey":"86:12","arabic":"وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ","translation":"And the earth that cracks open"},{"surah":86,"ayah":13,"verseKey":"86:13","arabic":"إِنَّهُۥ لَقَوۡلٞ فَصۡلٞ","translation":"It is a Decisive Word"},{"surah":86,"ayah":14,"verseKey":"86:14","arabic":"وَمَا هُوَ بِٱلۡهَزۡلِ","translation":"It is no joke"},{"surah":86,"ayah":15,"verseKey":"86:15","arabic":"إِنَّهُمۡ يَكِيدُونَ كَيۡدٗا","translation":"They plot and scheme"},{"surah":86,"ayah":16,"verseKey":"86:16","arabic":"وَأَكِيدُ كَيۡدٗا","translation":"But I plot and scheme"},{"surah":86,"ayah":17,"verseKey":"86:17","arabic":"فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا","translation":"Therefore, give the blasphemers respite, a brief respite"}]