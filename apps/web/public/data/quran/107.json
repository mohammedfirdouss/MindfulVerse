[{"surah":107,"ayah":1,"verseKey":"107:1","arabic":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ","translation":"Have you considered him who denies the religion"},{"surah":107,"ayah":2,"verseKey":"107:2","arabic":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ","translation":"It is he who mistreats the orphan"},{"surah":107,"ayah":3,"verseKey":"107:3","arabic":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","translation":"And does not encourage the feeding of the poor"},{"surah":107,"ayah":4,"verseKey":"107:4","arabic":"فَوَيۡلٞ لِّلۡمُصَلِّينَ","translation":"So woe to those who pray"},{"surah":107,"ayah":5,"verseKey":"107:5","arabic":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ","translation":"Those who are heedless of their prayers"},{"surah":107,"ayah":6,"verseKey":"107:6","arabic":"ٱلَّذِينَ هُمۡ يُرَآءُونَ","translation":"Those who put on the appearance"},{"surah":107,"ayah":7,"verseKey":"107:7","arabic":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ","translation":"And withhold the assistance"}]