[{"surah":101,"ayah":1,"verseKey":"101:1","arabic":"ٱلۡقَارِعَةُ","translation":"The Shocker"},{"surah":101,"ayah":2,"verseKey":"101:2","arabic":"مَا ٱلۡقَارِعَةُ","translation":"What is the Shocker"},{"surah":101,"ayah":3,"verseKey":"101:3","arabic":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ","translation":"What will explain to you what the Shocker is"},{"surah":101,"ayah":4,"verseKey":"101:4","arabic":"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ","translation":"The Day when the people will be like scattered moths"},{"surah":101,"ayah":5,"verseKey":"101:5","arabic":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ","translation":"And the mountains will be like tufted wool"},{"surah":101,"ayah":6,"verseKey":"101:6","arabic":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ","translation":"As for he whose scales are heavy"},{"surah":101,"ayah":7,"verseKey":"101:7","arabic":"فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ","translation":"He will be in a pleasant life"},{"surah":101,"ayah":8,"verseKey":"101:8","arabic":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ","translation":"But as for he whose scales are light"},{"surah":101,"ayah":9,"verseKey":"101:9","arabic":"فَأُمُّهُۥ هَاوِيَةٞ","translation":"His home is the Abyss"},{"surah":101,"ayah":10,"verseKey":"101:10","arabic":"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ","translation":"Do you know what it is"},{"surah":101,"ayah":11,"verseKey":"101:11","arabic":"نَارٌ حَامِيَةُۢ","translation":"A Raging Fire"}]