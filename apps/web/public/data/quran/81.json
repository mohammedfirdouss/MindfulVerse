[{"surah":81,"ayah":1,"verseKey":"81:1","arabic":"إِذَا ٱلشَّمۡسُ كُوِّرَتۡ","translation":"When the sun is rolled up"},{"surah":81,"ayah":2,"verseKey":"81:2","arabic":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ","translation":"When the stars are dimmed"},{"surah":81,"ayah":3,"verseKey":"81:3","arabic":"وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ","translation":"When the mountains are set in motion"},{"surah":81,"ayah":4,"verseKey":"81:4","arabic":"وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ","translation":"When the relationships are suspended"},{"surah":81,"ayah":5,"verseKey":"81:5","arabic":"وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ","translation":"When the beasts are gathered"},{"surah":81,"ayah":6,"verseKey":"81:6","arabic":"وَإِذَا ٱلۡبِحَارُ سُجِّرَتۡ","translation":"When the oceans are set aflame"},{"surah":81,"ayah":7,"verseKey":"81:7","arabic":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ","translation":"When the souls are paired"},{"surah":81,"ayah":8,"verseKey":"81:8","arabic":"وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ","translation":"When the girl, buried alive, is asked"},{"surah":81,"ayah":9,"verseKey":"81:9","arabic":"بِأَيِّ ذَنۢبٖ قُتِلَتۡ","translation":"For what crime was she killed"},{"surah":81,"ayah":10,"verseKey":"81:10","arabic":"وَإِذَا ٱلصُّحُفُ نُشِرَتۡ","translation":"When the records are made public"},{"surah":81,"ayah":11,"verseKey":"81:11","arabic":"وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ","translation":"When the sky is peeled away"},{"surah":81,"ayah":12,"verseKey":"81:12","arabic":"وَإِذَا ٱلۡجَحِيمُ سُعِّرَتۡ","translation":"When the Fire is set ablaze"},{"surah":81,"ayah":13,"verseKey":"81:13","arabic":"وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ","translation":"When Paradise is brought near"},{"surah":81,"ayah":14,"verseKey":"81:14","arabic":"عَلِمَتۡ نَفۡسٞ مَّآ أَحۡضَرَتۡ","translation":"Each soul will know what it has readied"},{"surah":81,"ayah":15,"verseKey":"81:15","arabic":"فَلَآ أُقۡسِمُ بِٱلۡخُنَّسِ","translation":"I swear by the galaxies"},{"surah":81,"ayah":16,"verseKey":"81:16","arabic":"ٱلۡجَوَارِ ٱلۡكُنَّسِ","translation":"Precisely running their courses"},{"surah":81,"ayah":17,"verseKey":"81:17","arabic":"وَٱلَّيۡلِ إِذَا عَسۡعَسَ","translation":"And by the night as it recedes"},{"surah":81,"ayah":18,"verseKey":"81:18","arabic":"وَٱلصُّبۡحِ إِذَا تَنَفَّسَ","translation":"And by the morn as it breathes"},{"surah":81,"ayah":19,"verseKey":"81:19","arabic":"إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ","translation":"This is the speech of a noble messenger"},{"surah":81,"ayah":20,"verseKey":"81:20","arabic":"ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينٖ","translation":"Endowed with power, eminent with the Lord of the Throne"},{"surah":81,"ayah":21,"verseKey":"81:21","arabic":"مُّطَاعٖ ثَمَّ أَمِينٖ","translation":"Obeyed and honest"},{"surah":81,"ayah":22,"verseKey":"81:22","arabic":"وَمَا صَاحِبُكُم بِمَجۡنُونٖ","translation":"Your friend is not possessed"},{"surah":81,"ayah":23,"verseKey":"81:23","arabic":"وَلَقَدۡ رَءَاهُ بِٱلۡأُفُقِ ٱلۡمُبِينِ","translation":"He saw him on the luminous horizon"},{"surah":81,"ayah":24,"verseKey":"81:24","arabic":"وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضَنِينٖ","translation":"And He does not withhold knowledge of the Unseen"},{"surah":81,"ayah":25,"verseKey":"81:25","arabic":"وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنٖ رَّجِيمٖ","translation":"And it is not the word of an accursed devil"},{"surah":81,"ayah":26,"verseKey":"81:26","arabic":"فَأَيۡنَ تَذۡهَبُونَ","translation":"So where are you heading"},{"surah":81,"ayah":27,"verseKey":"81:27","arabic":"إِنۡ هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ","translation":"It is only a Reminder to all mankind"},{"surah":81,"ayah":28,"verseKey":"81:28","arabic":"لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ","translation":"To whoever of you wills to go straight"},{"surah":81,"ayah":29,"verseKey":"81:29","arabic":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ","translation":"But you cannot will, unless God wills—The Lord of the Worlds"}]