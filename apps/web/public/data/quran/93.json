[{"surah":93,"ayah":1,"verseKey":"93:1","arabic":"وَٱلضُّحَىٰ","translation":"By the morning light"},{"surah":93,"ayah":2,"verseKey":"93:2","arabic":"وَٱلَّيۡلِ إِذَا سَجَىٰ","translation":"And the night as it settles"},{"surah":93,"ayah":3,"verseKey":"93:3","arabic":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","translation":"Your Lord did not abandon you, nor did He forget"},{"surah":93,"ayah":4,"verseKey":"93:4","arabic":"وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ ٱلۡأُولَىٰ","translation":"The Hereafter is better for you than the First"},{"surah":93,"ayah":5,"verseKey":"93:5","arabic":"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ","translation":"And your Lord will give you, and you will be satisfied"},{"surah":93,"ayah":6,"verseKey":"93:6","arabic":"أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوَىٰ","translation":"Did He not find you orphaned, and sheltered you"},{"surah":93,"ayah":7,"verseKey":"93:7","arabic":"وَوَجَدَكَ ضَآلّٗا فَهَدَىٰ","translation":"And found you wandering, and guided you"},{"surah":93,"ayah":8,"verseKey":"93:8","arabic":"وَوَجَدَكَ عَآئِلٗا فَأَغۡنَىٰ","translation":"And found you in need, and enriched you"},{"surah":93,"ayah":9,"verseKey":"93:9","arabic":"فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ","translation":"Therefore, do not mistreat the orphan"},{"surah":93,"ayah":10,"verseKey":"93:10","arabic":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ","translation":"Nor rebuff the seeker"},{"surah":93,"ayah":11,"verseKey":"93:11","arabic":"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ","translation":"But proclaim the blessings of your Lord"}]